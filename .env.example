# --- Database ---
# Local dev uses SQLite. The production target is Postgres + PostGIS (see docker-compose.yml).
DATABASE_URL="file:./dev.db"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=4000
API_URL="http://localhost:4000"
JWT_SECRET="dev-only-change-me"

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_DEFAULT_MARKET="en"

# --- Auth0 (stub for v1) ---
AUTH0_DOMAIN=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""

# --- Object storage ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="compralo-uploads"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# --- Payments ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# --- 3rd-party verticals (vehicles) ---
NHTSA_VPIC_BASE="https://vpic.nhtsa.dot.gov/api"
REPUVE_BASE=""

# --- Moderation / translation ---
DEEPL_API_KEY=""
AWS_REKOGNITION_REGION="us-east-1"
