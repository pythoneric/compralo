{
  "name": "compralo",
  "private": true,
  "version": "0.0.1",
  "description": "Bilingual marketplace for new and used items, including vehicles",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./apps/* dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @compralo/db generate",
    "db:migrate": "pnpm --filter @compralo/db migrate",
    "db:seed": "pnpm --filter @compralo/db seed",
    "db:reset": "pnpm --filter @compralo/db reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5"
  }
}
