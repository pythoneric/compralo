generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Minimal first cut. Vehicles, images, threads, offers, orders, reviews land in
// follow-up PRs — keeping this skeleton small so it boots end-to-end on day one.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         String   @default("buyer")
  market       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings Listing[]
}

model Listing {
  id          String   @id @default(cuid())
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])
  title       String
  description String
  priceCents  BigInt
  currency    String
  condition   String   @default("used_good")
  market      String
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerId])
  @@index([market, status])
}
